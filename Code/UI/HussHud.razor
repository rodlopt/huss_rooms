@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Construct;
@using Hussrooms;
@namespace Hussrooms.UI
@inherits PanelComponent

<root class="@(Player.IsValid() ? "" : "hidden")">

	@if (Player.IsValid())
	{
		<div class="role @RoleClass">
			<div class="role-name">@(Player.IsChaser ? "CAPTAIN CLARK" : "CLARK")</div>
		</div>
		<div class="pips">
			@for (int i = 0; i < Player.HitsToKill; i++)
			{
				<div class="pip @(i < Player.HitsRemaining ? "full" : "gone")">
					<i class="heart">❤</i>
				</div>
			}
		</div>
		@if (Player.IsRunner)
		{
			<div class="stamina @StaminaClass">
				<div class="track">
					<div class="fill" style="width: @(Player.StaminaFraction * 100)%;"></div>
				</div>
			</div>
		}


		@if (Player.IsSafe)
		{
			<div class="banner safe">SAFE ROOM</div>
		}

		@if (Player.IsDowned)
		{
			<div class="banner downed">DOWNED &mdash; GETTING BACK UP</div>
		}

		@if (ShiftLocked)
		{
			<div class="shiftlock">shiftlocked</div>
		}

		<div class="keys">
			<span>
				@if (!string.IsNullOrEmpty( SprintGlyph ))
				{
					<img src="@SprintGlyph" class="glyph" />
				}
				else
				{
					<b>SHIFT</b>
				}
				<span class="key-label"> Sprint</span>
			</span>
			<span>
				@if (!string.IsNullOrEmpty( RotateGlyph ))
				{
					<img src="@RotateGlyph" class="glyph" />
				}
				else
				{
					<b>RMB</b>
				}
				<span class="key-label"> Turn With camera</span>
			</span>
			<span>
				@if (!string.IsNullOrEmpty( ShiftLockGlyph ))
				{
					<img src="@ShiftLockGlyph" class="glyph" />
				}
				else
				{
					<b>ALT</b>
				}
				<span class="key-label"> ShiftLock</span>
			</span>
			<span>
				@if (!string.IsNullOrEmpty( TauntGlyph ))
				{
					<img src="@TauntGlyph" class="glyph" />
				}
				else
				{
					<b>F</b>
				}
				<span class="key-label"> Taunt</span>
			</span>
			<span>
				@if (!string.IsNullOrEmpty( TransformGlyph ))
				{
					<img src="@TransformGlyph" class="glyph" />
				}
				else
				{
					<b>T</b>
				}
				<span class="key-label"> @(Player.IsChaser ? "Become Clark" : "Become Captain Clark")</span>
			</span>
		</div>
	}

</root>

@code
{
	HussPlayer Player => HussPlayer.Local;

	string RoleClass => Player.IsValid() && Player.IsChaser ? "clark" : "captain clark";

	string StaminaClass
	{
		get
		{
			if (!Player.IsValid()) return "";
			if (Player.IsChaser) return "unused";
			if (Player.IsExhausted) return "spent";

			return "";
		}
	}

	bool ShiftLocked => Player.IsValid() && Player.Camera.IsValid() && Player.Camera.ShiftLock;

	/// <summary>
	/// Rebuild only when something on screen actually changed. Stamina is bucketed so we
	/// aren't re-rendering the whole tree every frame while it drains.
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine(
		Player.IsValid(),
		Player?.Team,
		Player?.HitsRemaining,
		(int)((Player?.StaminaFraction ?? 0) * 50),
		Player?.IsSafe,
		Player?.IsDowned,
		System.HashCode.Combine(Player?.IsSprinting, Player?.IsExhausted, ShiftLocked));

	string SprintGlyph => Input.GetGlyph("Run", InputGlyphSize.Medium, true).ResourcePath ?? "";
	string RotateGlyph => Player.IsValid() && Player.Camera.IsValid()
		? Input.GetGlyph(Player.Camera.RotateBodyButton ?? "Attack2", InputGlyphSize.Medium, true).ResourcePath ?? ""
		: "";
	string ShiftLockGlyph => Player.IsValid() && Player.Camera.IsValid()
		? Input.GetGlyph(Player.Camera.ShiftLockButton ?? "ShiftLock", InputGlyphSize.Medium, true).ResourcePath ?? ""
		: "";
	
	string TauntGlyph => Input.GetGlyph("Taunt", InputGlyphSize.Medium, true).ResourcePath ?? "";
	string TransformGlyph => Input.GetGlyph("Transform", InputGlyphSize.Medium, true).ResourcePath ?? "";
}
